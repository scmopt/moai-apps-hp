{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "moai-apps-hp.vercel.app" }],
      "destination": "https://saas.moai-lab.jp/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/pamphlet_(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/manuals/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
